# Copy this file to .env. No model API keys are required.

# Local Ollama installation and model tag.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b

# Defaults for a four-core, 16 GB laptop. One inference runs at a time
# across backtests, retrospective analysis, and daily feedback.
OLLAMA_NUM_THREAD=4
OLLAMA_NUM_CTX=8192
OLLAMA_KEEP_ALIVE=30m

# Use Qwen's direct-answer mode so the existing response-token budgets
# are available for decisions and explanations. Set true to enable thinking.
OLLAMA_THINK=false

# Seconds to wait for model output; 0 means no read deadline.
# Connecting to Ollama still has a five-second timeout.
OLLAMA_TIMEOUT_SECONDS=0

# Optional application configuration.
DATABASE_URL=sqlite:///./test.db
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
DEBUG=true
LOG_LEVEL=INFO
