# Copy this file to .env. No model API keys are required.

# Local Ollama installation and model tag.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b

# Defaults for a four-core, 16 GB laptop. One inference runs at a time
# across backtests, retrospective analysis, and daily feedback.
OLLAMA_NUM_THREAD=4
OLLAMA_NUM_CTX=8192
OLLAMA_KEEP_ALIVE=30m

# Use Qwen's direct-answer mode so the existing response-token budgets
# are available for decisions and explanations. Set true to enable thinking.
OLLAMA_THINK=false

# Seconds to wait for model output; 0 means no read deadline.
# Connecting to Ollama still has a five-second timeout.
OLLAMA_TIMEOUT_SECONDS=0

# Optional override for the durable local stage evidence database.
# Default: data/stage-gates.sqlite3 under the project root.
# PIPELINE_DB_PATH=/absolute/path/to/stage-gates.sqlite3
PIPELINE_NUM_THREADS=4
# Use the same lock path for every backend process sharing this installation.
# PIPELINE_LOCK_PATH=/absolute/path/to/stage-work.lock

# Optional application configuration.
DEBUG=true
LOG_LEVEL=INFO

# Controller memory: immutable originals, overlapping chunks, recent decisions
MEMORY_CHUNK_CHARS=768
MEMORY_RECENT_EPISODES=6
# Memory database is PIPELINE_DB_PATH with .memory.sqlite3 appended.


# Continuous market intelligence, separate from all portfolio databases.
INTELLIGENCE_ENABLED=true
# INTELLIGENCE_DB_PATH=/absolute/path/to/market-intelligence.sqlite3
INTELLIGENCE_NETWORK_JOBS=2
INTELLIGENCE_MAX_BYTES=2000000
INTELLIGENCE_USER_AGENT=TomeyGeneralCompany-MarketResearch/1.0
INTELLIGENCE_FEEDS=[]
INTELLIGENCE_BENCHMARKS=SPY,^GSPC,XLK,XLF,XLE,XLI,XLU,CL=F,GC=F,^TNX,EURUSD=X
# Identify your operator/contact before enabling SEC requests.
SEC_USER_AGENT=
# Optional public FRED/ALFRED API adapter:
FRED_API_KEY=
INTELLIGENCE_FRED_SERIES=DFF
